   "body": "{\"ok\":false,\"error\":\"that conversation is gone\"}"
  }
 },
 {
  "name": "rename ok (title 80 chars cut to 60)",
  "user": "u",
  "method": "POST",
  "path": "/conversations/rename",
  "body": "{\"id\":\"00000001\",\"title\":\"  TTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTT\"}",
  "expect": {
   "status": 200,
   "body": "{\"ok\":true}"
  }
 },
 {
  "name": "save update after rename keeps custom title",
  "user": "u",
  "method": "POST",
  "path": "/conversations",
  "body": "{\"id\":\"00000001\",\"messages\":[{\"role\":\"user\",\"content\":\"m9\"}]}",
  "expect": {
   "status": 200,
   "body": "{\"ok\":true,\"id\":\"00000001\"}"
  }
 },
 {
  "name": "list after rename",
  "user": "u",
  "method": "GET",
  "path": "/conversations",
  "body": null,
  "expect": {
   "status": 200,
   "body": "{\"ok\":true,\"conversations\":[{\"id\":\"00000001\",\"title\":\"TTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTT\",\"count\":1,\"at\":1760000000002}]}"
  }
 },
