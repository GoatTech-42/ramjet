[
 {
  "name": "list empty",
  "user": "u",
  "method": "GET",
  "path": "/conversations",
  "body": null,
  "expect": {
   "status": 200,
   "body": "{\"ok\":true,\"conversations\":[]}"
  }
 },
 {
  "name": "get unknown",
  "user": "u",
  "method": "GET",
  "path": "/conversations/messages?id=deadbeef",
  "body": null,
  "expect": {
   "status": 404,
   "body": "{\"ok\":false,\"error\":\"that conversation is gone\"}"
  }
 },
 {
  "name": "get no id",
  "user": "u",
  "method": "GET",
  "path": "/conversations/messages",
  "body": null,
  "expect": {
   "status": 404,
   "body": "{\"ok\":false,\"error\":\"that conversation is gone\"}"
  }
 },
 {
  "name": "save empty array",
  "user": "u",
  "method": "POST",
  "path": "/conversations",
  "body": "{\"messages\":[]}",
  "expect": {
   "status": 400,
   "body": "{\"ok\":false,\"error\":\"nothing to save yet\"}"
  }
 },
 {
  "name": "save not array",
  "user": "u",
  "method": "POST",
  "path": "/conversations",
  "body": "{\"messages\":\"x\"}",
  "expect": {
   "status": 400,
   "body": "{\"ok\":false,\"error\":\"nothing to save yet\"}"
  }
 },
 {
  "name": "save garbage body",
  "user": "u",
  "method": "POST",
  "path": "/conversations",
  "body": "{ nope",
  "expect": {
   "status": 400,
   "body": "{\"ok\":false,\"error\":\"nothing to save yet\"}"
  }
 },
 {
  "name": "save only invalid msgs",
  "user": "u",
  "method": "POST",
  "path": "/conversations",
  "body": "{\"messages\":[{\"role\":\"system\",\"content\":\"x\"},{\"role\":\"user\",\"content\":\"   \"},null,{\"role\":\"user\"}]}",
  "expect": {
   "status": 400,
   "body": "{\"ok\":false,\"error\":\"nothing to save yet\"}"
  }
 },
 {
  "name": "save ok title from first user msg (ws collapsed, 60 cap)",
  "user": "u",
  "method": "POST",
  "path": "/conversations",
  "body": "{\"messages\":[{\"role\":\"assistant\",\"content\":\"hello\"},{\"role\":\"user\",\"content\":\"  word  word  word  word  word  word  word  word  word  word  word  word  word  word  word  word  word  word  word  word  word  word  word  word  word  word  word  word  word  word   \"},{\"role\":\"assistant\",\"content\":\"reply\"}]}",
  "expect": {
   "status": 200,
   "body": "{\"ok\":true,\"id\":\"00000001\"}"
  }
 },
 {
  "name": "list one",
  "user": "u",
  "method": "GET",
  "path": "/conversations",
  "body": null,
  "expect": {
   "status": 200,
   "body": "{\"ok\":true,\"conversations\":[{\"id\":\"00000001\",\"title\":\"word word word word word word word word word word word word \",\"count\":3,\"at\":1760000000000}]}"
  }
 },
 {
  "name": "get messages (id 00000001)",
  "user": "u",
  "method": "GET",
  "path": "/conversations/messages?id=00000001",
  "body": null,
  "expect": {
   "status": 200,
   "body": "{\"ok\":true,\"conversation\":{\"id\":\"00000001\",\"title\":\"word word word word word word word word word word word word \",\"messages\":[{\"role\":\"assistant\",\"content\":\"hello\"},{\"role\":\"user\",\"content\":\"  word  word  word  word  word  word  word  word  word  word  word  word  word  word  word  word  word  word  word  word  word  word  word  word  word  word  word  word  word  word   \"},{\"role\":\"assistant\",\"content\":\"reply\"}]}}"
  }
 },
 {
  "name": "get messages id with trailing space is trimmed",
  "user": "u",
  "method": "GET",
  "path": "/conversations/messages?id=%2000000001%20",
  "body": null,
  "expect": {
   "status": 200,
   "body": "{\"ok\":true,\"conversation\":{\"id\":\"00000001\",\"title\":\"word word word word word word word word word word word word \",\"messages\":[{\"role\":\"assistant\",\"content\":\"hello\"},{\"role\":\"user\",\"content\":\"  word  word  word  word  word  word  word  word  word  word  word  word  word  word  word  word  word  word  word  word  word  word  word  word  word  word  word  word  word  word   \"},{\"role\":\"assistant\",\"content\":\"reply\"}]}}"
  }
 },
 {
  "name": "save update existing id keeps title unless custom",
  "user": "u",
  "method": "POST",
  "path": "/conversations",
  "body": "{\"id\":\"00000001\",\"messages\":[{\"role\":\"user\",\"content\":\"m1\"},{\"role\":\"assistant\",\"content\":\"m2\"},{\"role\":\"user\",\"content\":\"m3\"}]}",
  "expect": {
   "status": 200,
   "body": "{\"ok\":true,\"id\":\"00000001\"}"
  }
 },
 {
  "name": "rename empty",
  "user": "u",
  "method": "POST",
  "path": "/conversations/rename",
  "body": "{\"id\":\"00000001\",\"title\":\"   \"}",
  "expect": {
   "status": 400,
   "body": "{\"ok\":false,\"error\":\"give it a name\"}"
  }
 },
 {
  "name": "rename unknown",
  "user": "u",
  "method": "POST",
  "path": "/conversations/rename",
  "body": "{\"id\":\"deadbeef\",\"title\":\"x\"}",
  "expect": {
