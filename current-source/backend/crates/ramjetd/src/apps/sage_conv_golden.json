  "user": "cap",
  "method": "POST",
  "path": "/conversations/delete",
  "body": "{\"id\":\"deadbeef\"}",
  "expect": {
   "status": 404,
   "body": "{\"ok\":false,\"error\":\"that conversation is gone\"}"
  }
 },
