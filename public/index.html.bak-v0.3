<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Ramjet - GoatTech</title>
<meta name="description" content="Ramjet: a fast web proxy by GoatTech.">
<link rel="icon" href="/assets/ramjet.svg" type="image/svg+xml">
<link rel="manifest" href="/site.webmanifest">
<meta name="theme-color" content="#0b0c0e">
<link rel="stylesheet" href="/style.css">
<script src="/scram/scramjet.all.js"></script>
<script src="/baremux/index.js"></script>
<script src="/rjcrypto.js"></script>
<script src="/app.js" defer></script>
</head>
<body>

<div id="rj-tabs"><div id="rj-tablist"></div></div>

<header id="rj-chrome">
	<img src="/assets/ramjet.svg" alt="" class="mark">
	<span class="byline">goattech</span>
	<button id="rj-gear" type="button" title="Settings" aria-label="Settings">
		<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="8" r="2.2"/><path d="M8 1.8v1.7M8 12.5v1.7M1.8 8h1.7M12.5 8h1.7M3.6 3.6l1.2 1.2M11.2 11.2l1.2 1.2M12.4 3.6l-1.2 1.2M4.8 11.2l-1.2 1.2"/></svg>
	</button>
</header>

<main id="rj-landing">
	<h1 class="wordmark-big">ram<em>jet</em></h1>
	<p class="tag">a web proxy that butts through.</p>
</main>

<form id="rj-form" autocomplete="off" spellcheck="false">
	<div class="rj-nav">
		<button id="rj-back" type="button" title="Back" aria-label="Back">&larr;</button>
		<button id="rj-fwd" type="button" title="Forward" aria-label="Forward">&rarr;</button>
		<button id="rj-reload" type="button" title="Reload" aria-label="Reload">&#8635;</button>
		<button id="rj-home" type="button" title="Home" aria-label="Home"><img src="/assets/ramjet.svg" alt=""></button>
		<button id="rj-star" type="button" title="Bookmark this page" aria-label="Bookmark">&#9734;</button>
		<button id="rj-cloak" type="button" title="Toggle tab cloak" aria-label="Cloak">
			<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M2 8s2.5-4 6-4 6 4 6 4-2.5 4-6 4-6-4-6-4z"/><circle cx="8" cy="8" r="1.6"/><path d="M2.5 13.5 13.5 2.5"/></svg>
		</button>
		<button id="rj-gear2" type="button" title="Settings" aria-label="Settings">
			<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="8" r="2.2"/><path d="M8 1.8v1.7M8 12.5v1.7M1.8 8h1.7M12.5 8h1.7M3.6 3.6l1.2 1.2M11.2 11.2l1.2 1.2M12.4 3.6l-1.2 1.2M4.8 11.2l-1.2 1.2"/></svg>
		</button>
		<button id="rj-fs" type="button" title="Hide the bar" aria-label="Hide the bar">
			<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 6V2h4M10 2h4v4M14 10v4h-4M6 14H2v-4"/></svg>
		</button>
		<a id="rj-logout" href="/auth/logout" title="Lock" aria-label="Lock"><svg viewBox="0 0 14 16" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="1.5" y="7" width="11" height="8" rx="1.5"/><path d="M4 7V4.5a3 3 0 0 1 6 0V7"/></svg></a>
	</div>
	<span class="prefix">//</span>
	<input id="rj-address" type="text" inputmode="url" placeholder="type a url or search" aria-label="Address or search">
	<button type="submit" class="ignite">ignite&nbsp;&#8594;</button>
	<div id="rj-suggest" hidden></div>
</form>

<p id="rj-hint">no accounts, no install. the whole web, one bar. <span class="kbd">/</span> focuses it.</p>
<div id="rj-dial"></div>

<div id="rj-peek" title="Show the bar"></div>
<div id="rj-find" hidden>
	<input id="rj-find-in" type="text" placeholder="find in page" autocomplete="off" spellcheck="false">
	<button id="rj-find-x" type="button" aria-label="Close find">&times;</button>
</div>
<div id="rj-bmbar" hidden></div>
<div id="rj-framehost" hidden></div>

<div id="rj-menu" hidden></div>

<div id="rj-pagehost" hidden>
	<div id="rj-panel-card" role="dialog" aria-label="Settings">
		<header>
			<h2>Settings</h2>
			<button id="rj-panel-close" type="button" aria-label="Close">&times;</button>
		</header>

		<section>
			<h3>Account</h3>
			<div id="rj-acct"></div>
		</section>

		<section id="rj-admin-sec" hidden>
			<h3>Admin</h3>
			<div id="rj-admin"></div>
			<label class="rj-check"><input id="rj-require-approval" type="checkbox"> Require approval for new accounts</label>
		</section>

		<section>
			<h3>Appearance</h3>
			<select id="rj-zoom" aria-label="Zoom" style="margin-bottom:12px">
				<option value="80">Zoom 80%</option>
				<option value="90">Zoom 90%</option>
				<option value="100">Zoom 100%</option>
				<option value="110">Zoom 110%</option>
				<option value="125">Zoom 125%</option>
				<option value="150">Zoom 150%</option>
			</select>
			<div id="rj-themes">
				<button type="button" data-theme="amber" style="--sw:#ffa028">amber</button>
				<button type="button" data-theme="mint" style="--sw:#34d399">mint</button>
				<button type="button" data-theme="sky" style="--sw:#38bdf8">sky</button>
				<button type="button" data-theme="violet" style="--sw:#a78bfa">violet</button>
				<button type="button" data-theme="ember" style="--sw:#f87171">ember</button>
			</div>
		</section>

		<section>
			<h3>Search engine</h3>
			<select id="rj-engine">
				<option value="ddg">DuckDuckGo</option>
				<option value="google">Google</option>
				<option value="bing">Bing</option>
				<option value="brave">Brave</option>
			</select>
		</section>

		<section>
			<h3>Tab cloak</h3>
			<button id="rj-popout" type="button" class="rj-action">pop out to about:blank</button>
			<select id="rj-cloak-sel" style="margin-top:8px">
				<option value="off">Off</option>
				<option value="docs">Google Docs</option>
				<option value="classroom">Google Classroom</option>
				<option value="gmail">Gmail</option>
				<option value="wiki">Wikipedia</option>
			</select>
		</section>

		<section>
			<h3>Panic key</h3>
			<div class="rj-row">
				<select id="rj-panic-key">
					<option value="`">` (backtick)</option>
					<option value="F9">F9</option>
					<option value="Pause">Pause</option>
				</select>
				<input id="rj-panic-url" type="text" inputmode="url" spellcheck="false" aria-label="Panic destination">
			</div>
		</section>

		<section>
			<h3>Bookmarks</h3>
			<ul id="rj-bookmarks"></ul>
		</section>

		<section>
			<h3>History <button id="rj-history-clear" type="button" class="rj-mini">clear</button></h3>
			<ul id="rj-history"></ul>
			<label class="rj-check"><input id="rj-clearhist" type="checkbox"> Clear history when ramjet closes</label>
		</section>

		<section>
			<h3>Shortcuts</h3>
			<ul class="rj-keys">
				<li><span class="kbd">/</span> or <span class="kbd">ctrl k</span> focus the bar</li>
				<li><span class="kbd">`</span> panic</li>
				<li><span class="kbd">esc</span> close this panel</li>
				<li><span class="kbd">enter</span> ignite</li>
				<li><span class="kbd">ctrl l</span> focus the bar</li>
				<li><span class="kbd">ctrl f</span> find in page</li>
				<li><span class="kbd">alt &#8592;&#8594;</span> back / forward</li>
			</ul>
		</section>
			<p class="rj-ver">ramjet v0.3.0</p>
	</div>
</div>

<footer id="rj-foot">
	<span id="rj-status" data-mode="idle"></span>
	<span class="ver">v0.3.0</span>
</footer>

</body>
</html>
