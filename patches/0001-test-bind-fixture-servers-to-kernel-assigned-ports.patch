diff --git a/tests/fixture-server.test.mjs b/tests/fixture-server.test.mjs
new file mode 100644
index 0000000..7886d83
--- /dev/null
+++ b/tests/fixture-server.test.mjs
@@ -0,0 +1,34 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { existsSync, readFileSync } from 'node:fs';
+import { join } from 'node:path';
+import { withTempServer } from './fixtures/start-server.mjs';
+
+test('concurrent fixture servers use distinct ports and isolated roots', async () => {
+  const user = { username: 'isolation-user', password: 'isolation-password' };
+  await Promise.all([
+    withTempServer(async ({ root, base }) => {
+      assert.equal((await fetch(base + '/login')).status, 200);
+      // write real account data through this server's own API
+      const signup = await fetch(base + '/api/auth/signup', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(user) });
+      assert.equal(signup.status, 200);
+      const stored = JSON.parse(readFileSync(join(root, 'users.json'), 'utf8'))[user.username];
+      assert.ok(stored, 'own root holds the created user');
+      // known-but-pending (403) here proves the account lives in THIS root's store
+      const login = await fetch(base + '/api/auth/login', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(user) });
+      assert.equal(login.status, stored.status === 'pending' ? 403 : 200);
+    }),
+    withTempServer(async ({ root, base }) => {
+      assert.equal((await fetch(base + '/login')).status, 200);
+      // the other server's user must not exist here: not on disk, not by login
+      const usersPath = join(root, 'users.json');
+      assert.ok(!existsSync(usersPath) || !JSON.parse(readFileSync(usersPath, 'utf8'))[user.username], 'this root never sees the other server\'s user');
+      // unknown-account 401 (not the pending 403) proves it never leaked into this root
+      const login = await fetch(base + '/api/auth/login', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(user) });
+      assert.equal(login.status, 401);
+    }),
+    withTempServer(async ({ base }) => {
+      assert.equal((await fetch(base + '/login')).status, 200);
+    }),
+  ]);
+});
diff --git a/tests/fixtures/server.mjs b/tests/fixtures/server.mjs
new file mode 100644
index 0000000..dc16d8c
--- /dev/null
+++ b/tests/fixtures/server.mjs
@@ -0,0 +1,8 @@
+// Test-only bootstrap: bind port zero and publish the actual kernel-assigned port.
+import { Server } from 'node:net';
+const listen = Server.prototype.listen;
+Server.prototype.listen = function (...args) {
+  this.once('listening', () => process.stdout.write(`TEST_READY ${this.address().port}\n`));
+  return listen.apply(this, args);
+};
+await import('../../core/index.js');
diff --git a/tests/fixtures/start-server.mjs b/tests/fixtures/start-server.mjs
new file mode 100644
index 0000000..daba94d
--- /dev/null
+++ b/tests/fixtures/start-server.mjs
@@ -0,0 +1,63 @@
+import { spawn } from 'node:child_process';
+import { once } from 'node:events';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+
+const waitExit = async (child, ms) => {
+  if (child.exitCode !== null || child.signalCode !== null) return true;
+  const exit = once(child, 'exit').then(() => true, () => true);
+  const timeout = new Promise((r) => setTimeout(() => r(false), ms));
+  return Promise.race([exit, timeout]);
+};
+
+export async function startServer(root) {
+  const child = spawn(process.execPath, [new URL('./server.mjs', import.meta.url).pathname], {
+    cwd: new URL('../../', import.meta.url),
+    env: { ...process.env, RJ_HOST: '127.0.0.1', RJ_PORT: '0', RJ_DATA: root, RJ_ADMIN: 'reviewer' },
+    stdio: ['ignore', 'pipe', 'pipe'],
+  });
+  let log = '';
+  child.stderr.on('data', b => { log = (log + b).slice(-2000); });
+  // SIGTERM, then SIGKILL when the child ignores it - a stuck server must
+  // never hang the suite.
+  let stopped = false;
+  const stop = async () => {
+    if (stopped) return;
+    stopped = true;
+    if (child.exitCode !== null || child.signalCode !== null) return;
+    child.kill('SIGTERM');
+    if (!(await waitExit(child, 3000))) {
+      child.kill('SIGKILL');
+      await waitExit(child, 3000);
+    }
+  };
+  try {
+    const base = await new Promise((resolve, reject) => {
+      let output = '';
+      const timer = setTimeout(() => reject(Error('fixture startup timeout: ' + log)), 10000);
+      child.once('error', e => { clearTimeout(timer); reject(e); });
+      child.once('exit', code => { clearTimeout(timer); reject(Error('fixture exited ' + code + ': ' + log)); });
+      child.stdout.on('data', b => { output += b; const m = /TEST_READY (\d+)/.exec(output); if (m) { clearTimeout(timer); resolve('http://127.0.0.1:' + m[1]); } });
+    });
+    return { child, base, stop };
+  } catch (e) { await stop(); throw e; }
+}
+
+// Cleanup scope: owns the temp root's whole lifecycle. setup(root) runs
+// before the server starts (seed caches, users); fn never runs on startup
+// failure; the server is stopped and the root removed on every exit path,
+// so a failed startup cannot leak a mkdtemp root.
+export async function withTempServer(setup, fn) {
+  if (fn === undefined) { fn = setup; setup = null; }
+  const root = mkdtempSync(join(tmpdir(), 'rj-fixture-'));
+  let server = null;
+  try {
+    if (setup) await setup(root);
+    server = await startServer(root);
+    return await fn({ root, base: server.base });
+  } finally {
+    if (server) await server.stop();
+    rmSync(root, { recursive: true, force: true });
+  }
+}
